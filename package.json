{
  "name": "simple-task-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": "Christian Torrealba",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
